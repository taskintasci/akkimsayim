rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Bu yol artık kullanılmıyor — satırlar Firestore rowChunks'a yazılıyor
    // (bkz. src/firebase/rowStorage.js). Kullanılmayan bir yolu firma bazlı
    // yeniden tasarlamak yerine tamamen kilitliyoruz.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
