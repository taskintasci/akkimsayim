rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcının rolünü /users/{uid}.rol alanından okur
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }
    function isYonetici() {
      return request.auth != null && userRole() == 'yonetici';
    }

    match /sessions/{sessionId} {
      allow read:  if request.auth != null;
      allow write: if isYonetici();

      match /results/{rowId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null; // sayımcı kendi sonucunu yazar
      }

      match /rowChunks/{chunkId} {
        allow read:  if request.auth != null;
        allow write: if isYonetici();
      }

      // Sayımcı görevleri: yönetici oluşturur/siler; ilgili sayımcı yalnızca
      // kendi görevinin "durum" alanını güncelleyebilir (sayımı bitirince
      // görev listeden düşsün diye) veya artık var olmayan bir oturuma
      // (silinmiş sayım) ait öksüz kalan kendi görevini silebilir
      match /sayimciGorevler/{gorevId} {
        allow read:   if request.auth != null;
        allow create: if isYonetici();
        allow update: if isYonetici() || (
          request.auth != null &&
          request.auth.uid == resource.data.sayimciUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum'])
        );
        allow delete: if isYonetici() || (
          request.auth != null &&
          request.auth.uid == resource.data.sayimciUid &&
          !exists(/databases/$(database)/documents/sessions/$(sessionId))
        );
      }
    }

    // collectionGroup sorgusu için wildcard path — sayımcının tüm görevleri tek sorguda çekilir
    match /{path=**}/sayimciGorevler/{gorevId} {
      allow read: if request.auth != null;
    }

    match /users/{uid} {
      // Kendi profilini herkes okuyabilir; yönetici tüm kullanıcıları okur
      allow read:   if request.auth != null && (request.auth.uid == uid || isYonetici());
      // Yönetici yeni kullanıcı dokümanı yazar; kullanıcı kendi profilini (bootstrap) bir kez yaratabilir
      allow create: if request.auth != null && (request.auth.uid == uid || isYonetici());
      // Rol değiştirme / silme yalnızca yöneticide
      allow update, delete: if isYonetici();
    }
  }
}
